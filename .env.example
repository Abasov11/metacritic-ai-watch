# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash-lite

# --- crawler ---
# TZ=Europe/Moscow
# CRAWL_INTERVAL_MINUTES=60

# --- storage ---
# Каталог с базой и обложками. В контейнере это смонтированный volume.
# DATA_DIR=/app/data
# DATABASE_URL=sqlite:////app/data/app.db

# --- scraping (defaults are fine) ---
# REQUEST_TIMEOUT=20
# REQUEST_RETRIES=3
# REQUEST_DELAY=1.0

# --- YouTube let's plays ---
# YOUTUBE_ENABLED=1
#
# Субтитры требуют трёх вещей сразу; без любой из них YouTube отвечает
# "Sign in to confirm you're not a bot", и стадия честно пишет причину в карточку.
#   1) куки залогиненного аккаунта (формат Netscape, см. README);
#   2) node + скачиваемый решатель JS-челленджей;
#   3) PO-токен: плагин bgutil-ytdlp-pot-provider + собранный generate_once.js.
# YOUTUBE_COOKIES_FILE=/srv/skytec/metacritic-ai-watch/data/youtube-cookies.txt
# YOUTUBE_POT_SCRIPT=/srv/skytec/bgutil/server/build/generate_once.js
# YOUTUBE_JS_RUNTIME=node
# YOUTUBE_REMOTE_COMPONENTS=ejs:github
#
# Локальное распознавание речи, если субтитров нет вовсе (тяжёлое, по умолчанию выключено)
# YOUTUBE_WHISPER_ENABLED=0
