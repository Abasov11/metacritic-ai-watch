# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash-lite

# --- crawler ---
# TZ=Europe/Moscow
# CRAWL_INTERVAL_MINUTES=60

# --- storage ---
# DATABASE_URL=sqlite:///./data/app.db

# --- scraping (defaults are fine) ---
# REQUEST_TIMEOUT=20
# REQUEST_RETRIES=3
# REQUEST_DELAY=1.0

# --- YouTube let's plays ---
# YOUTUBE_ENABLED=1
# YouTube blocks video extraction from datacenter IPs; without a cookie jar the
# stage records the video it found but cannot read its captions.
# YOUTUBE_COOKIES_FILE=/srv/skytec/metacritic-ai-watch/data/youtube-cookies.txt
# YOUTUBE_WHISPER_ENABLED=0
